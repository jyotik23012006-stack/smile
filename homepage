<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hello | My Website</title>

    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:Arial, Helvetica, sans-serif;
        }

        body{
            background:linear-gradient(135deg,#6a11cb,#2575fc);
            color:white;
        }

        /* Navigation */
        nav{
            display:flex;
            justify-content:space-between;
            align-items:center;
            padding:20px 8%;
            background:rgba(255,255,255,0.1);
            backdrop-filter:blur(8px);
        }

        nav h2{
            font-size:30px;
        }

        nav ul{
            display:flex;
            list-style:none;
        }

        nav ul li{
            margin-left:25px;
        }

        nav ul li a{
            color:white;
            text-decoration:none;
            font-size:18px;
            transition:.3s;
        }

        nav ul li a:hover{
            color:yellow;
        }

        /* Hero Section */
        .hero{
            height:90vh;
            display:flex;
            justify-content:center;
            align-items:center;
            text-align:center;
            padding:20px;
        }

        .hero h1{
            font-size:70px;
            margin-bottom:20px;
        }

        .hero p{
            font-size:22px;
            margin-bottom:30px;
            max-width:700px;
            line-height:1.6;
        }

        .btn{
            display:inline-block;
            text-decoration:none;
            color:white;
            background:#ff4b5c;
            padding:15px 35px;
            border-radius:40px;
            font-size:20px;
            transition:.3s;
        }

        .btn:hover{
            background:#ff1e38;
            transform:scale(1.05);
        }

        footer{
            text-align:center;
            padding:20px;
            background:rgba(0,0,0,0.2);
        }

        @media(max-width:768px){

            nav{
                flex-direction:column;
            }

            nav ul{
                margin-top:15px;
            }

            .hero h1{
                font-size:45px;
            }

            .hero p{
                font-size:18px;
            }

        }

    </style>

</head>
<body>

<nav>
    <h2>🌐 My Website</h2>

    <ul>
        <li><a href="#">Home</a></li>
        <li><a href="#">About</a></li>
        <li><a href="#">Gallery</a></li>
        <li><a href="#">Contact</a></li>
    </ul>
</nav>

<section class="hero">

    <div>
        <h1>Hello! 👋</h1>

        <p>
            Welcome to my website. I'm happy you're here!
            Explore my pages and discover exciting content,
            beautiful memories, and amazing experiences.
        </p>

        <a href="#" class="btn">Get Started</a>
    </div>

</section>

<footer>
    <p>© 2026 My Website | Made with ❤️</p>
</footer>

</body>
</html>
